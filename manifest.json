{
  "manifest_version": 3,
  "name": "crossDSA",
  "version": "2.1.0",
  "description": "Find related DSA problems, track coding activity, and manage practice in your crossDSA dashboard.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": ["scripting", "notifications"],
  "optional_host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://atcoder.jp/*",
    "https://kenkoooo.com/*",
    "https://www.codechef.com/*",
    "https://authapi.geeksforgeeks.org/*",
    "https://practiceapi.geeksforgeeks.org/*",
    "https://www.naukri.com/*",
    "https://takeuforward.org/*",
    "https://backend-go.takeuforward.org/*"
  ],
  "icons": {
    "16": "icons/cDSA-16.png",
    "32": "icons/cDSA-32.png", 
    "48": "icons/cDSA-48.png",
    "128": "icons/cDSA-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://takeuforward.org/*"],
      "js": ["tracker/platforms/tuf-session.js"]
    },
    {
      "matches": ["https://www.naukri.com/code360/*"],
      "js": ["tracker/platforms/code360-history-bridge.js"]
    },
    {
      "matches": ["https://www.naukri.com/code360/*"],
      "js": ["tracker/platforms/code360-session.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.geeksforgeeks.org/problems/*",
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://www.codechef.com/problems/*",
        "https://www.naukri.com/code360/*",
        "https://atcoder.jp/contests/*/tasks/*"
      ],
      "js": ["tracker/platforms/solved-browser.js"]
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["tracker/platforms/leetcode-session.js", "tracker/platforms/leetcode-browser.js"]
    },
    {
      "matches": [
        "https://takeuforward.org/practice/dsa*",
        "https://takeuforward.org/plus/dsa/problems/*",
        "https://leetcode.com/problems/*",
        "https://www.geeksforgeeks.org/problems/*",
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://www.codechef.com/problems/*",
        "https://www.naukri.com/code360/problems/*",
        "https://atcoder.jp/contests/*/tasks/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "crossDSA"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/leetcode-data.json", "data/geeksforgeeks-data.json", "data/codeforces-data.json", "data/codechef-data.json", "data/code360-data.json", "data/atcoder-data.json", "data/normalized/runtime.json", "tracker/question-catalog.mjs"],
      "matches": [
        "https://takeuforward.org/*",
        "https://leetcode.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://codeforces.com/*",
        "https://www.codechef.com/*",
        "https://www.naukri.com/*",
        "https://atcoder.jp/*"
      ]
    }
  ]
}
